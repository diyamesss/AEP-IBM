# AEP × IBM Backend — Environment Configuration
#
# Copy this file to .env and fill in your actual values.
# The .env file is excluded from Git (see .gitignore).
# NEVER commit real secrets to this repository.
#
# ─────────────────────────────────────────────────
# monday.com configuration
# ─────────────────────────────────────────────────

# Your monday.com API token (Personal Access Token or OAuth token)
# Server-side ONLY — never exposed to the React frontend
MONDAY_API_TOKEN=REPLACE_WITH_YOUR_MONDAY_API_TOKEN

# The monday board ID for AEP × IBM resource tracking
MONDAY_BOARD_ID=18431218352

# ─────────────────────────────────────────────────
# Server configuration
# ─────────────────────────────────────────────────

# Port the backend listens on (default: 3001)
PORT=3001

# CORS — restrict to your actual frontend origin in production
# Examples:
#   ALLOWED_ORIGIN=https://your-org.github.io
#   ALLOWED_ORIGIN=http://localhost:5173
ALLOWED_ORIGIN=*
